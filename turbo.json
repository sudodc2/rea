{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "500MB",
  "globalDependencies": [".nvmrc", ".npmrc"],
  "globalPassThroughEnv": [
    "GOMAXPROCS",
    "GOMEMLIMIT",
    "UV_THREADPOOL_SIZE",
    "REA_TYPESCRIPT_COMPILER"
  ],
  "tasks": {
    "compile": {
      "dependsOn": ["metadata:check"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/run-turbo.mjs",
        "tooling/run-typescript.mjs",
        "tooling/check-dependency-install.mjs",
        "tooling/clean-build-output.mjs",
        "tooling/bundle-runtime.mjs",
        "tooling/record-catalog-digests.mjs",
        "tooling/record-mcp-catalog.mjs",
        "tooling/generate-package-metadata.mjs",
        "core/**/*.{cts,mts,ts,tsx}",
        "core/**/package.json",
        "!core/**/*.test.ts",
        "!core/**/*.fixture.ts",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"],
      "env": ["REA_TYPESCRIPT_COMPILER"]
    },
    "typecheck": {
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/run-turbo.mjs",
        "tooling/run-typescript.mjs",
        "core/**/*.{cts,mts,ts,tsx}",
        "core/**/package.json",
        "spec/**/*.{cts,mts,ts,tsx}",
        "spec/**/package.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "vitest.config.ts",
        "tooling/**/*.d.{cts,mts,ts}",
        "tooling/**/package.json",
        ".github/actions/**/*.{cts,mts,ts,tsx}",
        ".github/**/package.json",
        "handbook/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "handbook/**/package.json",
        "!handbook/.vitepress/cache/**",
        "!handbook/.vitepress/dist/**"
      ],
      "outputs": [],
      "env": ["REA_TYPESCRIPT_COMPILER"]
    },
    "metadata:check": {
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-package-metadata.mjs",
        "tooling/lib/generated-file.mjs",
        "tooling/lib/verifier-source-loader.mjs",
        "core/domain/skillManifest.ts",
        "core/domain/result.ts",
        ".agents/skills/reverse-engineer-anything/SKILL.md",
        "core/generatedPackageMetadata.ts"
      ]
    },
    "lint": {
      "outputs": [".cache/static-checks/oxlint.json"],
      "inputs": [
        ".gitignore",
        ".oxlintrc.json",
        "package.json",
        "package-lock.json",
        "tooling/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "core/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "spec/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "handbook/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        ".github/actions/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "web/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "lua/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "!handbook/.vitepress/cache/**",
        "!handbook/.vitepress/dist/**",
        "!web/_site/**",
        "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}"
      ]
    },
    "format:check": {},
    "knip": {
      "dependsOn": ["compile"],
      "inputs": [
        ".gitignore",
        "knip.json",
        "package.json",
        "package-lock.json",
        "tooling/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "core/**/*.ts",
        "spec/**/*.ts",
        ".github/actions/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        ".github/**/package.json",
        ".github/workflows/*.{yml,yaml}",
        ".github/**/action.{yml,yaml}",
        "tsconfig.json",
        "tsconfig.build.json",
        "handbook/.vitepress/config.ts",
        "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}"
      ]
    },
    "jscpd": {
      "inputs": [
        ".gitignore",
        ".jscpd.json",
        "package.json",
        "package-lock.json",
        "tooling/ci/static-check-report.mjs",
        "core/**",
        "spec/**"
      ],
      "outputs": [".cache/static-checks/jscpd/jscpd-report.json"]
    },
    "scan:todos": {
      "inputs": [
        "provider-bridges/**/*.{java,py}",
        "tooling/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "core/**/*.ts",
        "spec/**/*.ts"
      ]
    },
    "test:run": {
      "cache": false,
      "dependsOn": [
        "artifacts:mcp-catalog",
        "artifacts:product-catalog",
        "artifacts:managed-evidence",
        "artifacts:skills"
      ]
    },
    "docs:check:built": {
      "dependsOn": [
        "artifacts:product-catalog",
        "artifacts:managed-evidence",
        "artifacts:skills"
      ],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-*.mjs",
        "tooling/check-doc-facts.mjs",
        "tooling/lib/*.mjs",
        "tooling/verify/managed/*.mjs",
        "tooling/fixtures/managed/*.mjs",
        "tooling/verify/apple/*.mjs",
        "tooling/fixtures/apple/*.mjs",
        "core/generated*.ts",
        "core/contracts/**/*.ts",
        "attribution/**",
        "handbook/**",
        "!handbook/public/product-catalog.json",
        "!handbook/verification/managed-conformance-*.json",
        ".agents/skills/reverse-engineer-anything/**",
        "README*.md",
        {
          "mode": "dependencyOutputs",
          "globs": [
            "skills/**",
            "handbook/public/product-catalog.json",
            "handbook/verification/managed-conformance-manifest.json",
            "handbook/verification/managed-conformance-ledger.json"
          ]
        }
      ]
    },
    "artifacts:mcp-catalog": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-mcp-tool-catalog.mjs",
        "tooling/lib/generated-file.mjs"
      ],
      "outputs": [".cache/mcp-tool-catalog.json"]
    },
    "artifacts:skills": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-skill-metadata.mjs",
        "tooling/lib/generated-file.mjs",
        "tooling/lib/verifier-source-loader.mjs",
        ".agents/skills/reverse-engineer-anything/**"
      ],
      "outputs": ["skills/**"]
    },
    "artifacts:product-catalog": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-product-catalog.mjs",
        "tooling/lib/**/*.mjs",
        ".oxfmtrc.json"
      ],
      "outputs": ["handbook/public/product-catalog.json"]
    },
    "artifacts:managed-evidence": {
      "dependsOn": ["artifacts:skills"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-completion-ledger.mjs",
        "tooling/lib/generated-file.mjs",
        "tooling/verify/managed/**",
        "tooling/fixtures/managed/**"
      ],
      "outputs": [
        "handbook/verification/managed-conformance-manifest.json",
        "handbook/verification/managed-conformance-ledger.json"
      ]
    },
    "artifacts:error-schema": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-error-schema.mjs",
        "tooling/lib/generated-file.mjs",
        "tooling/lib/format-generated-file.mjs",
        ".oxfmtrc.json"
      ],
      "outputs": ["handbook/error-contract.schema.json"]
    },
    "mcp-catalog:check:built": {
      "dependsOn": ["artifacts:mcp-catalog"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-mcp-tool-catalog.mjs",
        "tooling/lib/generated-file.mjs",
        {
          "mode": "dependencyOutputs",
          "globs": [".cache/mcp-tool-catalog.json"]
        }
      ]
    },
    "evidence:check:built": {
      "dependsOn": ["artifacts:managed-evidence"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "tooling/generate-completion-ledger.mjs",
        "tooling/lib/generated-file.mjs",
        "tooling/verify/managed/**",
        "tooling/fixtures/managed/**",
        {
          "mode": "dependencyOutputs",
          "globs": [
            "handbook/verification/managed-conformance-manifest.json",
            "handbook/verification/managed-conformance-ledger.json"
          ]
        }
      ]
    }
  }
}
