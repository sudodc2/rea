{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "core/main.ts",
    "core/cli.ts",
    "core/cliOutput.ts",
    "core/cliBuiltinArguments.ts",
    "core/cli/cliResultOutput.ts",
    "core/mcpDoctor.ts",
    "core/composition/javascriptAnalysisWorkerProcess.ts",
    "core/composition/webBundleAnalysisWorkerProcess.ts",
    "core/contracts/errorSchemas.ts",
    "tooling/verify/fridaBindingsCompatibility.ts",
    "tooling/verify/termux/browser.mjs",
    "tooling/verify-real-ghidra-noreturn.mjs",
    "tooling/verify-real-ghidra-decompiler-failure.mjs",
    "tooling/verify-real-ghidra-decompile-timeout.mjs",
    "spec/processOwnershipRunner.ts"
  ],
  "project": ["core/**/*.ts", "spec/**/*.ts", "tooling/**/*.mjs"],
  "vitepress": {
    "entry": ["handbook/.vitepress/config.ts"]
  },
  "ignoreBinaries": ["^g\\+\\+$", "mkfifo"],
  "ignoreDependencies": [
    "@stryker-mutator/command-runner",
    "electron",
    "esbuild",
    "webpack"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error"
  }
}
