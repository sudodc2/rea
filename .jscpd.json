{
  "threshold": 4,
  "reporters": ["consoleFull"],
  "ignore": [
    "node_modules/**",
    "dist/**",
    "handbook/**",
    ".codex/**",
    ".devin/**",
    "spec/fixtures/**",
    "vendor/**",
    "spec/conformance/**/*.c",
    "spec/conformance/**/*.m",
    "spec/conformance/**/*.swift",
    "spec/conformance/**/*.xib"
